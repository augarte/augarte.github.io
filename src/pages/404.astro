---
import Layout from "../layouts/Layout.astro";
import "../styles/portfolio.css";
---

<Layout
  title="404 — Page not found"
  description="This page doesn’t exist."
  themeColor="#141414"
>
  <div class="portfolio">
    <header class="portfolio-header" data-dark>
      <nav class="portfolio-nav" aria-label="Portfolio">
        <a class="chapter-counter" href="/">Aimar Ugarte</a>
        <div class="portfolio-nav-links">
          <a href="/#projects">Work</a>
          <a href="/#experience">Experience</a>
          <a href="/#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="chapter chapter-notfound" data-dark aria-labelledby="notfound-title">
        <p class="chapter-inner chapter-label">Error / 404</p>
        <div class="chapter-inner">
          <h1 class="chapter-title" id="notfound-title">Page not found.</h1>
          <p class="chapter-lead">This page doesn’t exist or has moved. The work and the way to reach me are still on the home page.</p>
          <a class="display-link" href="/">Back to home</a>
        </div>
      </section>
    </main>
  </div>
</Layout>
